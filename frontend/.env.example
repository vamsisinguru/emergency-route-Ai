# Frontend environment variables
#
# Copy this file to .env.development for local development or .env.production
# for a custom production build.
#
# VITE_API_BASE_URL:
#   - Development (Vite dev server on :5173):
#       VITE_API_BASE_URL=http://127.0.0.1:8000
#   - Production (FastAPI serves the React build, same-origin):
#       Leave unset or empty so API calls use relative paths like /predict
#
# VITE_WS_URL (optional):
#   - Override the WebSocket URL. Defaults to ws://<current_host>/ws
#   - Development: VITE_WS_URL=ws://127.0.0.1:8000/ws
#   - Production: leave unset (uses same host as the page)
VITE_API_BASE_URL=http://127.0.0.1:8000
